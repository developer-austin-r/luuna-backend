# Production Environment Configuration
NODE_ENV=production
PORT=3000

# Database Configuration for Production
# These should be set via Docker environment variables or AWS Secrets Manager
DB_HOST=your-rds-endpoint.amazonaws.com
DB_PORT=5432
DB_NAME=luuna_db_prod
DB_USER=luuna_prod_user
DB_PASSWORD=${DB_PASSWORD_PROD}  # From AWS Secrets Manager or environment
DB_SCHEMA=public

# CORS Configuration (Restricted for production)
CORS_ORIGIN="https://yourdomain.com"
