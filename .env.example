# Application Environment
NODE_ENV=development
PORT=3000

# PostgreSQL database connection
# The app builds DATABASE_URL and SHADOW_DATABASE_URL from these values.
# Do not add DATABASE_URL or SHADOW_DATABASE_URL unless you intentionally
# change the database config code.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=luuna_db
DB_USER=luuna_user
DB_PASSWORD=luuna_pass
DB_SCHEMA=public

# CORS origin configuration
# Use "*" for development, or specify specific origins for production
CORS_ORIGIN=*
