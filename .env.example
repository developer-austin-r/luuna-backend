# Application Environment
NODE_ENV=development
PORT=3000

# Prisma database connection
# Format: postgresql://username:password@host:port/database?schema=public
DATABASE_URL="postgresql://user:password@localhost:5432/luuna_db?schema=public"

# Shadow database for Prisma migrations (optional but recommended)
SHADOW_DATABASE_URL="postgresql://user:password@localhost:5432/luuna_shadow?schema=public"

# CORS origin configuration
# Use "*" for development, or specify specific origins for production
CORS_ORIGIN="*"
