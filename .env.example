# Application Environment
NODE_ENV=development
PORT=3000

# PostgreSQL database connection
# The app builds DATABASE_URL and SHADOW_DATABASE_URL from these values.
# Do not add DATABASE_URL or SHADOW_DATABASE_URL unless you intentionally
# change the database config code.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=luuna_db
DB_USER=luuna_user
DB_PASSWORD=change_me
DB_SCHEMA=public

# CORS origin configuration
# Use "*" for development, or specify specific origins for production
CORS_ORIGIN=*

# ── Authentication ──────────────────────────────────────────────────────────
# JWT secrets — use long, random strings in production
JWT_SECRET=
JWT_REFRESH_SECRET=

# Token expiry (e.g. 15m, 1h, 7d)
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Failed login protection
AUTH_MAX_LOGIN_ATTEMPTS=3
AUTH_LOCK_DURATION_MINUTES=30

# ── Cookies ─────────────────────────────────────────────────────────────────
# Set to true in production (requires HTTPS)
COOKIE_SECURE=false
# Set your domain for production, leave empty for localhost
COOKIE_DOMAIN=
# Lax | Strict | None
COOKIE_SAME_SITE=Lax

# ── Frontend Base URL (Set in live/production, e.g. FRONTEND_URL=http://13.53.235.58) ───
FRONTEND_URL=http://localhost:3000

# ── WhatsApp Cloud API (server-side only) ───────────────────────────────────
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v25.0
# Must match an approved template and its language in Meta. The three body
# parameters are sent in this order: customer name, bill number, bill date.
WHATSAPP_TEMPLATE_NAME=jaspers_market_order_confirmation_v1
WHATSAPP_TEMPLATE_LANGUAGE=en_US

# ── WhatsApp Webhook ──────────────────────────────────────────────────────────
# A long random secret you choose and then paste into the Meta Developer portal
# under WhatsApp > Configuration > Webhook > Verify Token.
# Generate one with: openssl rand -hex 32
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
