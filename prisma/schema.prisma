datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model Role {
  id          String    @id @default(uuid()) @map("id")
  name        String    @unique @map("name")
  slug        String    @unique @map("slug")
  description String?   @map("description")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  users           User[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model User {
  id             String    @id @default(uuid()) @map("id")
  email          String    @unique @map("email")
  name           String?   @map("name")
  password       String    @map("password")
  isVerified     Boolean   @default(false) @map("is_verified")
  roleId         String?   @map("role_id")
  failedAttempts Int       @default(0) @map("failed_attempts")
  lockedUntil    DateTime? @map("locked_until")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  role           Role?     @relation(fields: [roleId], references: [id])
  status         String    @default("ACTIVE") @map("status")
  tokens         Token[]
  orders         Order[]
  activityLogs   ActivityLog[]

  @@index([roleId])
  @@map("users")
}

model Brand {
  id       String    @id @default(uuid()) @map("id")
  name     String    @map("name")
  logo     String?   @map("logo")
  status   Boolean   @default(true) @map("status")
  products Product[]

  @@index([name])
  @@map("brands")
}

model Category {
  id                String            @id @default(uuid()) @map("id")
  name              String            @map("name")
  slug              String            @unique @map("slug")
  parentId          String?           @map("parent_id")
  image             String?           @map("image")
  description       String?           @db.Text @map("description")
  status            Boolean           @default(true) @map("status")
  isDeleted         Boolean           @default(false) @map("is_deleted")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  parent            Category?         @relation("CategoryToCategory", fields: [parentId], references: [id], onDelete: SetNull)
  children          Category[]        @relation("CategoryToCategory")
  productCategories ProductCategory[]

  @@index([parentId])
  @@index([status, isDeleted])
  @@map("categories")
}

model Status {
  id       String    @id @default(uuid()) @map("id")
  status   String    @map("status")
  slug     String    @unique @map("slug")
  products Product[]

  @@map("statuses")
}

model Product {
  id                String            @id @default(uuid()) @map("id")
  sku               String            @unique @map("sku")
  barcode           String?           @unique @map("barcode")
  name              String            @map("name")
  slug              String            @unique @map("slug")
  shortDescription  String?           @map("short_description")
  description       String?           @db.Text @map("description")
  brandId           String?           @map("brand_id")
  basePrice         Decimal           @db.Decimal(10, 2) @map("base_price")
  discountPrice     Decimal?          @db.Decimal(10, 2) @map("discount_price")
  taxPercentage     Decimal           @default(0.00) @db.Decimal(5, 2) @map("tax_percentage")
  finalPrice        Decimal           @db.Decimal(10, 2) @map("final_price")
  stock             Int               @default(0) @map("stock")
  reservedStock     Int               @default(0) @map("reserved_stock")
  availableStock    Int               @default(0) @map("available_stock")
  rating            Float             @default(0) @map("rating")
  statusId          String            @map("status_id")
  productSize       String?           @map("product_size")
  deletedAt         DateTime?         @map("deleted_at")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  brand             Brand?            @relation(fields: [brandId], references: [id], onDelete: SetNull)
  status            Status            @relation(fields: [statusId], references: [id])
  productCategories ProductCategory[]
  images            ProductImage[]
  videos            ProductVideo[]
  inventories       Inventory[]
  keywords          ProductKeyword[]
  orderItems        OrderItem[]

  @@index([brandId])
  @@index([statusId])
  @@index([createdAt])
  @@map("products")
}

model ProductCategory {
  id         String   @id @default(uuid()) @map("id")
  productId  String   @map("product_id")
  categoryId String   @map("category_id")
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([productId, categoryId])
  @@index([productId])
  @@index([categoryId])
  @@map("product_categories")
}

model ProductImage {
  id           String  @id @default(uuid()) @map("id")
  productId    String  @map("product_id")
  imageUrl     String? @map("image_url")
  originalUrl  String  @default("") @map("original_url")
  displayUrl   String  @default("") @map("display_url")
  displayOrder Int     @default(0) @map("display_order")
  product      Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model ProductVideo {
  id        String  @id @default(uuid()) @map("id")
  productId String  @map("product_id")
  videoUrl  String  @map("video_url")
  fileSize  BigInt? @map("file_size")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_videos")
}

model Inventory {
  id             String   @id @default(uuid()) @map("id")
  productId      String   @map("product_id")
  totalStock     Int      @default(0) @map("total_stock")
  reservedStock  Int      @default(0) @map("reserved_stock")
  availableStock Int      @default(0) @map("available_stock")
  warehouse      String   @default("Main Warehouse") @map("warehouse")
  updatedAt      DateTime @updatedAt @map("updated_at")
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([warehouse])
  @@map("inventories")
}

model ProductKeyword {
  id        String  @id @default(uuid()) @map("id")
  productId String  @map("product_id")
  keyword   String  @map("keyword")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([keyword])
  @@map("product_keywords")
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum CouponStatus {
  ACTIVE
  INACTIVE
  EXPIRED
}

model Coupon {
  id                 String       @id @default(uuid()) @map("id")
  code               String       @unique @map("code")
  discountType       DiscountType @map("discount_type")
  discountValue      Decimal      @db.Decimal(10,2) @map("discount_value")
  minimumOrderAmount Decimal      @default(0.00) @db.Decimal(10,2) @map("minimum_order_amount")
  redemptionLimit    Int?         @map("redemption_limit")
  redeemedCount      Int          @default(0) @map("redeemed_count")
  activeDate         DateTime     @default(now()) @map("active_date")
  expiryDate         DateTime     @map("expiry_date")
  status             CouponStatus @default(ACTIVE) @map("status")
  description        String?      @db.Text @map("description")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")
  deletedAt          DateTime?    @map("deleted_at")

  @@index([code])
  @@index([status])
  @@index([expiryDate])
  @@map("coupons")
}

enum TokenType {
  REFRESH_TOKEN
  PASSWORD_RESET
  EMAIL_VERIFICATION
}

enum TokenStatus {
  ACTIVE
  USED
  REVOKED
  EXPIRED
}

model Token {
  id        String      @id @default(uuid()) @map("id")
  userId    String      @map("user_id")
  tokenHash String      @map("token_hash")
  tokenType TokenType   @map("token_type")
  status    TokenStatus @default(ACTIVE) @map("status")
  expiresAt DateTime    @map("expires_at")
  usedAt    DateTime?   @map("used_at")
  ipAddress String?     @map("ip_address")
  userAgent String?     @map("user_agent")
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("tokens")
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CREDIT_CARD
  PAYPAL
  STRIPE
  CASH_ON_DELIVERY
}

enum ShipmentStatus {
  PENDING
  IN_TRANSIT
  SHIPPED
  DELIVERED
  RETURNED
}

model Order {
  id             String        @id @default(uuid()) @map("id")
  orderNumber    String        @unique @map("order_number")
  userId         String        @map("user_id")
  orderStatus    OrderStatus   @default(PENDING) @map("order_status")
  paymentStatus  PaymentStatus @default(PENDING) @map("payment_status")
  paymentMethod  PaymentMethod @map("payment_method")
  subtotal       Decimal       @db.Decimal(10, 2) @map("subtotal")
  discount       Decimal       @default(0.00) @db.Decimal(10, 2) @map("discount")
  tax            Decimal       @default(0.00) @db.Decimal(10, 2) @map("tax")
  shippingCharge Decimal       @default(0.00) @db.Decimal(10, 2) @map("shipping_charge")
  totalAmount    Decimal       @db.Decimal(10, 2) @map("total_amount")
  notes          String?       @db.Text @map("notes")
  orderedAt      DateTime      @default(now()) @map("ordered_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  user           User          @relation(fields: [userId], references: [id])
  orderItems     OrderItem[]
  shipment       Shipment[]

  @@index([userId])
  @@index([orderNumber])
  @@map("orders")
}

// ──────────────────────────────────────────────────────────────
// RBAC
// ──────────────────────────────────────────────────────────────

model Permission {
  id          String    @id @default(uuid()) @map("id")
  name        String    @map("name")
  slug        String    @unique @map("slug")
  description String?   @map("description")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  rolePermissions RolePermission[]
  menus           Menu[]

  @@map("permissions")
}

model RolePermission {
  id           String @id @default(uuid()) @map("id")
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model Menu {
  id           String  @id @default(uuid()) @map("id")
  name         String  @map("name")
  slug         String  @unique @map("slug")
  icon         String? @map("icon")
  permissionId String? @map("permission_id")
  parentId     String? @map("parent_id")
  sortOrder    Int     @default(0) @map("sort_order")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  permission Permission? @relation(fields: [permissionId], references: [id])
  parent     Menu?       @relation("MenuHierarchy", fields: [parentId], references: [id])
  children   Menu[]      @relation("MenuHierarchy")

  @@index([permissionId])
  @@index([parentId])
  @@map("menus")
}

model OrderItem {
  id        String  @id @default(uuid()) @map("id")
  orderId   String  @map("order_id")
  productId String  @map("product_id")
  quantity  Int     @map("quantity")
  price     Decimal @db.Decimal(10, 2) @map("price")
  discount  Decimal @default(0.00) @db.Decimal(10, 2) @map("discount")
  tax       Decimal @default(0.00) @db.Decimal(10, 2) @map("tax")
  total     Decimal @db.Decimal(10, 2) @map("total")
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model Shipment {
  id              String         @id @default(uuid()) @map("id")
  orderId         String         @map("order_id")
  trackingNumber  String?        @map("tracking_number")
  courierName     String?        @map("courier_name")
  shipmentStatus  ShipmentStatus @default(PENDING) @map("shipment_status")
  shippingAddress String         @db.Text @map("shipping_address")
  city            String         @map("city")
  state           String         @map("state")
  postalCode      String         @map("postal_code")
  country         String         @map("country")
  phone           String?        @map("phone")
  shippedDate     DateTime?      @map("shipped_date")
  deliveredDate   DateTime?      @map("delivered_date")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  order           Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("shipments")
}

model Module {
  id          BigInt        @id @default(autoincrement()) @map("id")
  name        String        @unique @db.VarChar(100) @map("name")
  description String?       @db.VarChar(255) @map("description")
  isActive    Boolean       @default(true) @map("is_active")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  actions     Action[]
  activityLogs ActivityLog[]

  @@map("modules")
}

model Action {
  id          BigInt        @id @default(autoincrement()) @map("id")
  moduleId    BigInt        @map("module_id")
  name        String        @db.VarChar(100) @map("name")
  description String?       @db.VarChar(255) @map("description")
  isActive    Boolean       @default(true) @map("is_active")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  module      Module        @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  activityLogs ActivityLog[]

  @@unique([moduleId, name])
  @@index([moduleId])
  @@map("actions")
}

model ActivityLog {
  id          BigInt        @id @default(autoincrement()) @map("id")
  userId      String?       @map("user_id")
  sessionId   String?       @db.VarChar(100) @map("session_id")
  moduleId    BigInt        @map("module_id")
  actionId    BigInt        @map("action_id")
  entityId    String?       @map("entity_id")
  description String?       @db.VarChar(500) @map("description")
  ipAddress   String?       @db.VarChar(45) @map("ip_address")
  userAgent   String?       @db.Text @map("user_agent")
  deviceType  String?       @db.VarChar(20) @map("device_type")
  browser     String?       @db.VarChar(50) @map("browser")
  os          String?       @db.VarChar(50) @map("os")
  metadata    Json?         @map("metadata")
  createdAt   DateTime      @default(now()) @map("created_at")

  user        User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  module      Module        @relation(fields: [moduleId], references: [id])
  action      Action        @relation(fields: [actionId], references: [id])

  @@index([userId, createdAt])
  @@index([sessionId, createdAt])
  @@index([moduleId, createdAt])
  @@index([actionId, createdAt])
  @@index([entityId, createdAt])
  @@index([createdAt])
  @@map("activity_logs")
}

