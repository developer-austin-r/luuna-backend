datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid()) @map("id")
  email     String   @unique @map("email")
  name      String?  @map("name")
  password  String   @map("password")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Brand {
  id       String    @id @default(uuid()) @map("id")
  name     String    @map("name")
  logo     String?   @map("logo")
  status   Boolean   @default(true) @map("status")
  products Product[]

  @@index([name])
  @@map("brands")
}

model Category {
  id                String            @id @default(uuid()) @map("id")
  name              String            @map("name")
  slug              String            @unique @map("slug")
  parentId          String?           @map("parent_id")
  image             String?           @map("image")
  description       String?           @db.Text @map("description")
  status            Boolean           @default(true) @map("status")
  isDeleted         Boolean           @default(false) @map("is_deleted")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  parent            Category?         @relation("CategoryToCategory", fields: [parentId], references: [id], onDelete: SetNull)
  children          Category[]        @relation("CategoryToCategory")
  productCategories ProductCategory[]

  @@index([parentId])
  @@index([status, isDeleted])
  @@map("categories")
}

model Product {
  id                String            @id @default(uuid()) @map("id")
  sku               String            @unique @map("sku")
  name              String            @map("name")
  slug              String            @unique @map("slug")
  shortDescription  String?           @map("short_description")
  description       String?           @db.Text @map("description")
  brandId           String?           @map("brand_id")
  basePrice         Decimal           @db.Decimal(10, 2) @map("base_price")
  discountPrice     Decimal?          @db.Decimal(10, 2) @map("discount_price")
  taxPercentage     Decimal           @default(0.00) @db.Decimal(5, 2) @map("tax_percentage")
  finalPrice        Decimal           @db.Decimal(10, 2) @map("final_price")
  stock             Int               @default(0) @map("stock")
  reservedStock     Int               @default(0) @map("reserved_stock")
  availableStock    Int               @default(0) @map("available_stock")
  rating            Float             @default(0) @map("rating")
  archive           Boolean           @default(false) @map("archive")
  status            Boolean           @default(true) @map("status")
  deletedAt         DateTime?         @map("deleted_at")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  brand             Brand?            @relation(fields: [brandId], references: [id], onDelete: SetNull)
  productCategories ProductCategory[]
  images            ProductImage[]
  videos            ProductVideo[]
  inventories       Inventory[]
  keywords          ProductKeyword[]

  @@index([brandId])
  @@index([status, archive])
  @@index([createdAt])
  @@map("products")
}

model ProductCategory {
  id         String   @id @default(uuid()) @map("id")
  productId  String   @map("product_id")
  categoryId String   @map("category_id")
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([productId, categoryId])
  @@index([productId])
  @@index([categoryId])
  @@map("product_categories")
}

model ProductImage {
  id           String  @id @default(uuid()) @map("id")
  productId    String  @map("product_id")
  imageUrl     String  @map("image_url")
  displayOrder Int     @default(0) @map("display_order")
  product      Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model ProductVideo {
  id        String  @id @default(uuid()) @map("id")
  productId String  @map("product_id")
  videoUrl  String  @map("video_url")
  fileSize  BigInt? @map("file_size")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_videos")
}

model Inventory {
  id             String    @id @default(uuid()) @map("id")
  productId      String    @map("product_id")
  totalStock     Int       @default(0) @map("total_stock")
  reservedStock  Int       @default(0) @map("reserved_stock")
  availableStock Int       @default(0) @map("available_stock")
  warehouse      String    @map("warehouse")
  lastSync       DateTime? @map("last_sync")
  product        Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([warehouse])
  @@map("inventories")
}

model ProductKeyword {
  id        String  @id @default(uuid()) @map("id")
  productId String  @map("product_id")
  keyword   String  @map("keyword")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([keyword])
  @@map("product_keywords")
}