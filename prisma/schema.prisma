datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model Role {
  id          String   @id @default(uuid()) @map("id")
  name        String   @unique @map("name")
  description String?  @map("description")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  users       User[]

  @@map("roles")
}

model User {
  id             String    @id @default(uuid()) @map("id")
  email          String    @unique @map("email")
  name           String?   @map("name")
  password       String    @map("password")
  roleId         String?   @map("role_id")
  failedAttempts Int       @default(0) @map("failed_attempts")
  lockedUntil    DateTime? @map("locked_until")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  role           Role?     @relation(fields: [roleId], references: [id])
  orders         Order[]

  @@index([roleId])
  @@map("users")
}

model Brand {
  id       String    @id @default(uuid()) @map("id")
  name     String    @map("name")
  logo     String?   @map("logo")
  status   Boolean   @default(true) @map("status")
  products Product[]

  @@index([name])
  @@map("brands")
}

model Category {
  id                String            @id @default(uuid()) @map("id")
  name              String            @map("name")
  slug              String            @unique @map("slug")
  parentId          String?           @map("parent_id")
  image             String?           @map("image")
  description       String?           @db.Text @map("description")
  status            Boolean           @default(true) @map("status")
  isDeleted         Boolean           @default(false) @map("is_deleted")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  parent            Category?         @relation("CategoryToCategory", fields: [parentId], references: [id], onDelete: SetNull)
  children          Category[]        @relation("CategoryToCategory")
  productCategories ProductCategory[]

  @@index([parentId])
  @@index([status, isDeleted])
  @@map("categories")
}

model Status {
  id       String    @id @default(uuid()) @map("id")
  status   String    @map("status")
  slug     String    @unique @map("slug")
  products Product[]

  @@map("statuses")
}

model Product {
  id                String            @id @default(uuid()) @map("id")
  sku               String            @unique @map("sku")
  name              String            @map("name")
  slug              String            @unique @map("slug")
  shortDescription  String?           @map("short_description")
  description       String?           @db.Text @map("description")
  brandId           String?           @map("brand_id")
  basePrice         Decimal           @db.Decimal(10, 2) @map("base_price")
  discountPrice     Decimal?          @db.Decimal(10, 2) @map("discount_price")
  taxPercentage     Decimal           @default(0.00) @db.Decimal(5, 2) @map("tax_percentage")
  finalPrice        Decimal           @db.Decimal(10, 2) @map("final_price")
  stock             Int               @default(0) @map("stock")
  reservedStock     Int               @default(0) @map("reserved_stock")
  availableStock    Int               @default(0) @map("available_stock")
  rating            Float             @default(0) @map("rating")
  statusId          String            @map("status_id")
  deletedAt         DateTime?         @map("deleted_at")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  brand             Brand?            @relation(fields: [brandId], references: [id], onDelete: SetNull)
  status            Status            @relation(fields: [statusId], references: [id])
  productCategories ProductCategory[]
  images            ProductImage[]
  videos            ProductVideo[]
  inventories       Inventory[]
  keywords          ProductKeyword[]
  orderItems        OrderItem[]

  @@index([brandId])
  @@index([statusId])
  @@index([createdAt])
  @@map("products")
}

model ProductCategory {
  id         String   @id @default(uuid()) @map("id")
  productId  String   @map("product_id")
  categoryId String   @map("category_id")
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([productId, categoryId])
  @@index([productId])
  @@index([categoryId])
  @@map("product_categories")
}

model ProductImage {
  id           String  @id @default(uuid()) @map("id")
  productId    String  @map("product_id")
  imageUrl     String  @map("image_url")
  displayOrder Int     @default(0) @map("display_order")
  product      Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model ProductVideo {
  id        String  @id @default(uuid()) @map("id")
  productId String  @map("product_id")
  videoUrl  String  @map("video_url")
  fileSize  BigInt? @map("file_size")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_videos")
}

model Inventory {
  id             String   @id @default(uuid()) @map("id")
  productId      String   @map("product_id")
  totalStock     Int      @default(0) @map("total_stock")
  reservedStock  Int      @default(0) @map("reserved_stock")
  availableStock Int      @default(0) @map("available_stock")
  warehouse      String   @default("Main Warehouse") @map("warehouse")
  updatedAt      DateTime @updatedAt @map("updated_at")
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([warehouse])
  @@map("inventories")
}

model ProductKeyword {
  id        String  @id @default(uuid()) @map("id")
  productId String  @map("product_id")
  keyword   String  @map("keyword")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([keyword])
  @@map("product_keywords")
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum CouponStatus {
  ACTIVE
  INACTIVE
  EXPIRED
}

model Coupon {
  id                 String       @id @default(uuid()) @map("id")
  code               String       @unique @map("code")
  discountType       DiscountType @map("discount_type")
  discountValue      Decimal      @db.Decimal(10,2) @map("discount_value")
  minimumOrderAmount Decimal      @default(0.00) @db.Decimal(10,2) @map("minimum_order_amount")
  redemptionLimit    Int?         @map("redemption_limit")
  redeemedCount      Int          @default(0) @map("redeemed_count")
  activeDate         DateTime     @default(now()) @map("active_date")
  expiryDate         DateTime     @map("expiry_date")
  status             CouponStatus @default(ACTIVE) @map("status")
  description        String?      @db.Text @map("description")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")
  deletedAt          DateTime?    @map("deleted_at")

  @@index([code])
  @@index([status])
  @@index([expiryDate])
  @@map("coupons")
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CREDIT_CARD
  PAYPAL
  COD
  STRIPE
  BANK_TRANSFER
}

enum ShipmentStatus {
  PENDING
  SHIPPED
  IN_TRANSIT
  DELIVERED
  RETURNED
}

model Order {
  id             String        @id @default(uuid()) @map("id")
  orderNumber    String        @unique @map("order_number")
  userId         String        @map("user_id")
  orderStatus    OrderStatus   @map("order_status")
  paymentStatus  PaymentStatus @map("payment_status")
  paymentMethod  PaymentMethod @map("payment_method")
  subtotal       Decimal       @db.Decimal(10, 2) @map("subtotal")
  discount       Decimal       @default(0.00) @db.Decimal(10, 2) @map("discount")
  tax            Decimal       @default(0.00) @db.Decimal(10, 2) @map("tax")
  shippingCharge Decimal       @default(0.00) @db.Decimal(10, 2) @map("shipping_charge")
  totalAmount    Decimal       @db.Decimal(10, 2) @map("total_amount")
  notes          String?       @map("notes")
  orderedAt      DateTime      @default(now()) @map("ordered_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  user       User        @relation(fields: [userId], references: [id])
  orderItems OrderItem[]
  shipment   Shipment[]

  @@index([userId])
  @@index([orderNumber])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(uuid()) @map("id")
  orderId   String  @map("order_id")
  productId String  @map("product_id")
  quantity  Int     @map("quantity")
  price     Decimal @db.Decimal(10, 2) @map("price")
  discount  Decimal @default(0.00) @db.Decimal(10, 2) @map("discount")
  tax       Decimal @default(0.00) @db.Decimal(10, 2) @map("tax")
  total     Decimal @db.Decimal(10, 2) @map("total")

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model Shipment {
  id               String         @id @default(uuid()) @map("id")
  orderId          String         @map("order_id")
  trackingNumber   String         @unique @map("tracking_number")
  courierName      String         @map("courier_name")
  shipmentStatus   ShipmentStatus @map("shipment_status")
  shippedDate      DateTime?      @map("shipped_date")
  expectedDelivery DateTime?      @map("expected_delivery")
  deliveredDate    DateTime?      @map("delivered_date")
  shippingAddress  String         @map("shipping_address")
  city             String         @map("city")
  state            String         @map("state")
  postalCode       String         @map("postal_code")
  country          String         @map("country")
  phone            String         @map("phone")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([trackingNumber])
  @@map("shipments")
}

